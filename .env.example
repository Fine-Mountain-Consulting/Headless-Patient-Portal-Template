# Copy to .env for local development. Never commit .env.

# ── Knack ────────────────────────────────────────────────────────────────
# The application id is not secret (Knack's loader endpoint publishes it).
KNACK_APP_ID=
# The REST API key IS secret: it bypasses every Knack permission. Server only.
# On Firebase it lives in Secret Manager instead (see docs/deploy-firebase.md).
KNACK_API_KEY=
# Commercial: https://api.knack.com/v1
# HIPAA / GovCloud tenants: https://usgc-api.knack.com/v1
# The commercial host ACCEPTS writes for a GovCloud app, returns 200, and
# drops them. Set this to match the tenant before the first write.
KNACK_API_HOST=https://api.knack.com/v1

# ── Sessions ─────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=
# Minutes of inactivity before sign-out (HIPAA automatic logoff).
SESSION_IDLE_MINUTES=15
# Hard limit on a session regardless of activity.
SESSION_MAX_HOURS=12

# ── Compliance tier ──────────────────────────────────────────────────────
# hipaa (default) or standard. A patient portal holds PHI: leave it on hipaa.
# On the hipaa tier the server refuses the commercial Knack host unless
# ALLOW_COMMERCIAL_HOST_FOR_DEMO=true, which is for synthetic demo data only.
COMPLIANCE_TIER=hipaa
ALLOW_COMMERCIAL_HOST_FOR_DEMO=false
# Record before/after field values in the change log. Off = who/what/when only.
AUDIT_VALUES=false

# ── Keeping up with Knack ────────────────────────────────────────────────
# Minutes between automatic re-reads of the Knack app structure (fields,
# pages, access). 0 turns it off; then only `npm run sync` + restart updates it.
SYNC_MINUTES=5
# Knack's metadata endpoint. Change only if your tenant uses a different one.
KNACK_LOADER_URL=https://loader.knack.com/v1

# ── Branding ─────────────────────────────────────────────────────────────
APP_NAME=Patient Portal
# Where "Forgot password?" sends people. Defaults to the Knack live app.
PASSWORD_RESET_URL=

# ── Node server only ─────────────────────────────────────────────────────
PORT=8787
DATA_DIR=./data
