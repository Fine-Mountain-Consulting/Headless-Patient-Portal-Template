rules_version = '2';
// Deny everything to clients. Only the `api` function (Admin SDK) reads or
// writes Firestore. If a rule ever needs to open, something is talking to the
// database that shouldn't be.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
