{
  "functions": [
    {
      "source": "packages/server-firebase",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "src",
        "*.log",
        "build.mjs",
        "tsconfig.json"
      ],
      "predeploy": [
        "npm run build -w @headless/server-firebase"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
